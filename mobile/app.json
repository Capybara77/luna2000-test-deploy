{
  "expo": {
    "name": "Luna2000",
    "slug": "luna2000-driver",
    "version": "1.0.5",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "luna2000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.luna2000.app"
    },
    "android": {
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#3273dc"
      },
      "package": "com.luna2000.app",
      "usesCleartextTraffic": true
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
