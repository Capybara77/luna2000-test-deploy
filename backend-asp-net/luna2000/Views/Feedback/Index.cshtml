<section class="section">
    <div class="container">
        <h1 class="title">Обратная связь</h1>

        @if (ViewBag.ShowMessage == true)
        {
            <div class="notification is-primary">
                <button class="delete"></button>
                @ViewBag.StatusMessage
            </div>
        }

        <div class="box">
            <form action="/Feedback/Send" method="post">
                @Html.AntiForgeryToken()

                <div class="field">
                    <label class="label">Сообщение</label>
                    <div class="control">
                        <textarea class="textarea" name="message" placeholder="Ваше сообщение" required></textarea>
                    </div>
                </div>

                <div class="field">
                    <label class="label">Номер телефона</label>
                    <div class="control">
                        <input class="input" type="tel" name="phoneNumber" placeholder="+7 (999) 123-45-67" required>
                    </div>
                </div>

                <div class="field">
                    <div class="control">
                        <button type="submit" class="button is-primary is-fullwidth">Отправить</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        (document.querySelectorAll('.notification .delete') || []).forEach(($delete) => {
            const $notification = $delete.parentNode;
            $delete.addEventListener('click', () => {
                $notification.parentNode.removeChild($notification);
            });

            setTimeout(() => {
                if ($notification.parentNode) {
                    $notification.parentNode.removeChild($notification);
                }
            }, 5000);
        });
    });
</script>