<section class="section">
    <div class="container">
        <h1 class="title">Добавить Водителя</h1>

        <nav class="breadcrumb" aria-label="breadcrumbs">
            <ul>
                <li><a href="/">Главная</a></li>
                <li><a href="/driver">Водители</a></li>
                <li class="is-active"><a href="#" aria-current="page">Добавить</a></li>
            </ul>
        </nav>

        <form id="addDriverForm" enctype="multipart/form-data">
            <div class="field">
                <label class="label" for="fio">ФИО:</label>
                <div class="control">
                    <input class="input" type="text" id="fio" name="fio" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="aliases">Псевдонимы:</label>
                <div class="control">
                    <textarea class="textarea" type="text" id="aliases" name="aliases" placeholder="Фамилия Имя
Фамилия И.О.
и т.д."></textarea>
                </div>
            </div>

            <div class="field">
                <label class="label" for="balance">Баланс:</label>
                <div class="control">
                    <input class="input" type="number" id="balance" name="balance" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="passport">Паспорт:</label>
                <div class="control">
                    <input class="input" type="text" id="passport" name="passport" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="registration">Прописка:</label>
                <div class="control">
                    <input class="input" type="text" id="registration" name="registration" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="address">Адрес проживания:</label>
                <div class="control">
                    <input class="input" type="text" id="address" name="address" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="driverLicense">Водительское удостоверение:</label>
                <div class="control">
                    <input class="input" type="text" id="driverLicense" name="driverLicense" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="parkingAddress">Адрес парковки:</label>
                <div class="control">
                    <input class="input" type="text" id="parkingAddress" name="parkingAddress" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="contacts">Контакты:</label>
                <div class="control">
                    <input class="input" type="text" id="contacts" name="contacts" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="note">Примечание:</label>
                <div class="control">
                    <textarea class="textarea" id="note" name="note"></textarea>
                </div>
            </div>

            <div class="field">
                <label class="label" for="photos">Фотографии (до 4 штук):</label>
                <div class="control">
                    <input class="input" type="file" id="photos" name="photos" multiple accept="image/*">
                </div>
            </div>

            <div class="field is-grouped">
                <div class="control">
                    <button class="button is-primary" type="submit">Добавить Водителя</button>
                </div>
                <div class="control">
                    <button class="button is-light" type="button" onclick="window.history.back();">Назад</button>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts
    {
    <script src="/js/add-driver.js"></script>
}
