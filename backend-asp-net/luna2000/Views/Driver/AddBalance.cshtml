@model DriverEntity

<section class="section">
    <div class="container">
        <nav class="breadcrumb" aria-label="breadcrumbs">
            <ul>
                <li><a href="/">Главная</a></li>
                <li><a href="/driver">Водители</a></li>
                <li class="is-active"><a href="#" aria-current="page">Пополнить баланс</a></li>
            </ul>
        </nav>

        <h1 class="title">Внести депозит для @Model.Fio</h1>
        <p class="subtitle">Текущий баланс: @Model.Balance</p>

        <form action="/driver/addbalance" method="post">
            <input name="driverId" value="@Model.Id" hidden>

            <div class="field">
                <label class="label" for="balanceInput">Депозит:</label>
                <div class="control">
                    <input class="input" name="balance" type="number" id="balanceInput" required>
                </div>
            </div>

            <div class="field">
                <div class="control">
                    <button class="button is-primary" type="submit">Внести депозит</button>
                </div>
            </div>
        </form>
    </div>
</section>