@using luna2000.Extensions
@using luna2000.Options
@using Microsoft.Extensions.Options
@model luna2000.Dto.ViewHistoryDto
@inject IOptions<CommonDataConfiguration> Configuration

<div class="container table-container">
    <table class="table is-hoverable is-striped is-fullwidth">
        <thead>
            <tr>
                <th>Событие</th>
                <th>Текстовое описание</th>
                <th>Объект события</th>
                <th>Старое значение</th>
                <th>Новое значение</th>
                <th>Время</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var logGroup in Model.Items)
            {
                var firstLog = logGroup.First();

                <tr>
                    <td>@firstLog.EventType.GetDescription()</td>
                    <td>@firstLog.Note</td>
                    <td>
                        @foreach (var objName in logGroup.Select(dto => dto.ObjectName))
                        {
                            <p>@objName</p>
                        }
                    </td>
                    <td>
                        @foreach (var old in logGroup.Select(dto => dto.OldValue))
                        {
                            <p>@old</p>
                        }
                    </td>
                    <td>
                        @foreach (var newValue in logGroup.Select(dto => dto.NewValue))
                        {
                            <p>@newValue</p>
                        }
                    </td>
                    <td>@TimeZoneInfo.ConvertTimeFromUtc(firstLog.Created, TimeZoneInfo.FindSystemTimeZoneById(Configuration.Value.TimeZone)).ToString("HH:mm dd.MM.yyyy")</td>
                </tr>
            }
        </tbody>
    </table>

    @{
        var filterUrlParam = Model.ObjFilterId != Guid.Empty ? $"&objFilter={Model.ObjFilterId}" : string.Empty;
        var totalPages = (int)Math.Ceiling((double)Model.ItemsCount / Model.ItemsPerPage);
        var currentPage = Model.CurrentPage;
        // Количество отображаемых страниц с каждой стороны от текущей
        var visiblePages = 2;
    }

    <nav class="pagination is-centered" role="navigation" aria-label="pagination">
        @if (currentPage > 1)
        {
            <a class="pagination-previous" href="/history?page=@(currentPage - 1)@filterUrlParam">Предыдущая</a>
        }

        @if (currentPage < totalPages)
        {
            <a class="pagination-next" href="/history?page=@(currentPage + 1)@filterUrlParam">Следующая</a>
        }

        <ul class="pagination-list">
            @* Ссылка на первую страницу *@
            <li>
                <a class="pagination-link @(1 == currentPage ? "is-current" : "")" href="/history?page=1@filterUrlParam" aria-label="Goto page 1">1</a>
            </li>

            @* Левое многоточие *@
            @if (currentPage > visiblePages + 2)
            {
                <li><span class="pagination-ellipsis">&hellip;</span></li>
            }

            @* Основной диапазон страниц *@
            @for (var i = Math.Max(2, currentPage - visiblePages); i <= Math.Min(totalPages - 1, currentPage + visiblePages); i++)
            {
                <li>
                    <a class="pagination-link @(i == currentPage ? "is-current" : "")" href="/history?page=@i@filterUrlParam" aria-label="Goto page @i">@i</a>
                </li>
            }

            @* Правое многоточие *@
            @if (currentPage < totalPages - (visiblePages + 1))
            {
                <li><span class="pagination-ellipsis">&hellip;</span></li>
            }

            @* Ссылка на последнюю страницу *@
            @if (totalPages > 1)
            {
                <li>
                    <a class="pagination-link @(totalPages == currentPage ? "is-current" : "")" href="/history?page=@totalPages@filterUrlParam" aria-label="Goto page @totalPages">@totalPages</a>
                </li>
            }
        </ul>
    </nav>

    @* Форма для перехода на конкретную страницу *@
    @if (totalPages > (visiblePages * 2) + 3)
    {
        <div class="field has-addons is-justify-content-center mt-4">
            <div class="control">
                <input id="page-input" class="input" type="number" min="1" max="@totalPages" placeholder="№ страницы" style="width: 120px;">
            </div>
            <div class="control">
                <button id="page-go-btn" class="button is-info">
                    Перейти
                </button>
            </div>
        </div>
    }
</div>

<script>
    (function() {
        const goButton = document.getElementById('page-go-btn');
        const pageInput = document.getElementById('page-input');

        if (!goButton || !pageInput) {
            return;
        }

        const maxPage = parseInt(pageInput.getAttribute('max'), 10);
        const filterParam = '@Html.Raw(filterUrlParam)';

        function navigateToPage() {
            let pageNumber = parseInt(pageInput.value, 10);
            if (!isNaN(pageNumber) && pageNumber > 0 && pageNumber <= maxPage) {
                window.location.href = `/history?page=${pageNumber}${filterParam}`;
            } else {
                // Можно добавить обработку ошибки, например, подсветку поля
                pageInput.classList.add('is-danger');
            }
        }

        goButton.addEventListener('click', navigateToPage);

        pageInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                navigateToPage();
            }
        });

        pageInput.addEventListener('input', function() {
            pageInput.classList.remove('is-danger');
        });
    })();
</script>