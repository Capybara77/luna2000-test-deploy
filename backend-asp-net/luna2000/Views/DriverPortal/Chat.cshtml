@using luna2000.Models
@{
    ViewData["Title"] = "Общий чат";
    var driver = ViewBag.Driver as DriverEntity;
    var messages = ViewBag.Messages as List<ChatMessage> ?? new();
    var tz = ViewBag.TimeZone as TimeZoneInfo ?? TimeZoneInfo.Utc;
}

<style>
  .chat-wrap { display: flex; flex-direction: column; height: calc(100vh - 180px); }
  .chat-messages { flex: 1; overflow-y: auto; padding: 12px; }
  .msg { display: flex; gap: 10px; margin-bottom: 10px; }
  .msg.own { flex-direction: row-reverse; }
  .msg-bubble { max-width: 70%; padding: 8px 12px; border-radius: 12px; font-size: 0.9rem; word-break: break-word; }
  .msg.own .msg-bubble { background: #3273dc; color: white; border-radius: 12px 12px 0 12px; }
  .msg:not(.own) .msg-bubble { background: #f5f5f5; border-radius: 12px 12px 12px 0; }
  .msg-meta { font-size: 0.7rem; color: #999; margin-top: 2px; }
  .msg.own .msg-meta { text-align: right; }
  .chat-input-row { display: flex; gap: 8px; padding: 10px; border-top: 1px solid #ddd; }
  .chat-input-row input { flex: 1; }
  .avatar { width: 32px; height: 32px; border-radius: 50%; background: #3273dc;
            display: flex; align-items: center; justify-content: center;
            color: white; font-weight: bold; font-size: 0.75rem; flex-shrink: 0; }
  .msg.own .avatar { background: #48c774; }
</style>

<div class="is-flex is-align-items-center px-3 pt-3 pb-2" style="gap:12px; border-bottom:1px solid #eee">
  <a href="/driver-portal" class="button is-light is-small"><i class="fas fa-arrow-left"></i></a>
  <p class="title is-5 mb-0">💬 Общий чат</p>
</div>

<div class="chat-wrap">
  <div class="chat-messages" id="chatMessages">
    @foreach (var msg in messages)
    {
      var isOwn = msg.DriverId == driver?.Id;
      var localTime = TimeZoneInfo.ConvertTimeFromUtc(msg.CreatedAt, tz);
      var senderName = msg.Driver?.Fio ?? (msg.DriverId == Guid.Empty ? "Диспетчер" : "Водитель");
      var initials = senderName.Split(' ')
          .Where(p => p.Length > 0).Take(2)
          .Select(p => p[0].ToString().ToUpper())
          .Aggregate("", (a, b) => a + b);
      if (string.IsNullOrEmpty(initials)) initials = "Д";
      <div class="msg @(isOwn ? "own" : "")">
        <div class="avatar" title="@senderName">@initials</div>
        <div>
          @if (!isOwn)
          {
            <div style="font-size:0.75rem; font-weight:600; margin-bottom:2px">@senderName</div>
          }
          <div class="msg-bubble">@msg.Text</div>
          <div class="msg-meta">@localTime.ToString("HH:mm dd.MM")</div>
        </div>
      </div>
    }
  </div>

  <div class="chat-input-row">
    <input class="input" type="text" id="chatInput" placeholder="Написать сообщение..." maxlength="500"
           onkeydown="if(event.key==='Enter')sendMessage()">
    <button class="button is-primary" onclick="sendMessage()">
      <i class="fas fa-paper-plane"></i>
    </button>
  </div>
</div>

@section Scripts {
  <script src="https://kit.fontawesome.com/e5e3c0c905.js" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
  <script>
    const driverId = '@driver?.Id';
    const driverFio = '@driver?.Fio';

    // Прокрутить вниз при загрузке
    const chatMessages = document.getElementById('chatMessages');
    chatMessages.scrollTop = chatMessages.scrollHeight;

    // SignalR подключение
    const connection = new signalR.HubConnectionBuilder()
      .withUrl('/mobile/chathub')
      .withAutomaticReconnect()
      .build();

    connection.on('ReceiveMessage', function(msg) {
      appendMessage(msg);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    });

    connection.start()
      .then(() => connection.invoke('JoinChannel', 0))
      .catch(err => console.error('SignalR error:', err));

    function appendMessage(msg) {
      const isOwn = msg.driverId === driverId;
      const div = document.createElement('div');
      div.className = 'msg' + (isOwn ? ' own' : '');
      const initials = (msg.driverName || '?').split(' ').slice(0,2).map(p => p[0] || '').join('');
      const time = new Date(msg.createdAt + 'Z').toLocaleTimeString('ru', {hour:'2-digit',minute:'2-digit'});
      div.innerHTML = `
        <div class="avatar" title="${msg.driverName}">${initials}</div>
        <div>
          ${!isOwn ? `<div style="font-size:0.75rem;font-weight:600;margin-bottom:2px">${msg.driverName}</div>` : ''}
          <div class="msg-bubble">${msg.text}</div>
          <div class="msg-meta">${time}</div>
        </div>`;
      chatMessages.appendChild(div);
    }

    async function sendMessage() {
      const input = document.getElementById('chatInput');
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      try {
        await connection.invoke('SendMessage', 0, text);
      } catch(e) {
        console.error(e);
      }
    }
  </script>
}
