<div class="section is-medium">
    <div class="container">
        <div class="columns is-centered">
            <div class="column is-4">
                <div class="box">
                    <h1 class="title is-3 has-text-centered">Вход</h1>
                    <form id="loginForm" method="post">
                        <div class="field">
                            <label class="label" for="username">Логин</label>
                            <div class="control">
                                <input class="input" type="text" id="username" name="username" required />
                            </div>
                        </div>

                        <div class="field">
                            <label class="label" for="password">Пароль</label>
                            <div class="control">
                                <input class="input" type="password" id="password" name="password" required />
                            </div>
                        </div>

                        <div class="field">
                            <div class="control has-text-centered">
                                <button type="submit" class="button is-primary">Войти</button>
                            </div>
                        </div>

                        <p id="error" class="help is-danger" style="display: none">
                            Неверный логин или пароль
                        </p>
                    </form>
                </div>
                <div class="has-text-centered mt-4">
                    <a href="/download-apk" class="button is-small is-rounded is-link is-light font-weight-bold" style="text-decoration:none;">
                        <span class="icon is-small"><i class="fab fa-android"></i></span>
                        <span>📱 Скачать приложение для водителей (APK)</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="js/login.js"></script>
}
