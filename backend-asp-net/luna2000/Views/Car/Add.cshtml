<section class="section">
    <div class="container">
        <h1 class="title">Добавить новый автомобиль</h1>

        <nav class="breadcrumb" aria-label="breadcrumbs">
            <ul>
                <li><a href="/">Главная</a></li>
                <li><a href="/car">Автомобили</a></li>
                <li class="is-active"><a href="#" aria-current="page">Добавить</a></li>
            </ul>
        </nav>


        <form id="addCarForm">
            <div class="field">
                <label class="label" for="brandModel">Марка/Модель:</label>
                <div class="control">
                    <input class="input" type="text" id="brandModel" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="pts">ПТС:</label>
                <div class="control">
                    <input class="input" type="text" id="pts" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="sts">СТС:</label>
                <div class="control">
                    <input class="input" type="text" id="sts" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="vin">VIN-Код:</label>
                <div class="control">
                    <input class="input" type="text" id="vin" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="year">Год выпуска:</label>
                <div class="control">
                    <input class="input" type="number" id="year" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="registrationDate">Дата постановки на учет:</label>
                <div class="control">
                    <input class="input" type="date" id="registrationDate">
                </div>
            </div>

            <div class="field">
                <label class="label" for="plateNumber">Госномер:</label>
                <div class="control">
                    <input class="input" type="text" id="plateNumber" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="osago">ОСАГО:</label>
                <div class="control">
                    <input class="input" type="text" id="osago" required>
                </div>
            </div>

            <div class="field">
                <label class="label" for="kasko">КАСКО:</label>
                <div class="control">
                    <input class="input" type="text" id="kasko">
                </div>
            </div>

            <div class="field">
                <label class="label" for="techInspection">Техосмотр:</label>
                <div class="control">
                    <input class="input" type="date" id="techInspection">
                </div>
            </div>

            <div class="field">
                <div class="control">
                    <label class="checkbox" for="taxiLicense">
                        <input type="checkbox" id="taxiLicense">
                        Лицензия такси
                    </label>
                </div>
            </div>


            <div class="field">
                <label class="label" for="purchaseOrRent">Выкуп или аренда:</label>
                <div class="control">
                    <input class="input" type="text" id="purchaseOrRent">
                </div>
            </div>


            <div class="field">
                <div class="control">
                    <label class="checkbox" for="leasing">
                        <input type="checkbox" id="leasing">
                        В лизинге
                    </label>
                </div>
            </div>


            <div class="field">
                <label class="label" for="photos">Фото автомобиля (до 10 шт.):</label>
                <div class="control">
                    <input class="input" type="file" id="photos" accept="image/*" multiple>
                </div>
            </div>

            <div class="field is-grouped">
                <p class="control">
                    <button class="button is-primary" type="submit">Добавить автомобиль</button>
                </p>
                <p class="control">
                    <button class="button is-light" type="button" onclick="window.history.back();">Назад</button>
                </p>
            </div>
        </form>
    </div>
</section>
@section Scripts
{
    <script src="/js/add-car.js"></script>
}
