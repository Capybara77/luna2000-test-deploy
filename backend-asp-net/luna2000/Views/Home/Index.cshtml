@using System.Globalization
@model luna2000.Dto.MainViewDto

<section class="section">
    @(await Html.PartialAsync("/Views/Elements/StatsView.cshtml", Model.StatsDto))

    <div class="container is-fluid px-0">
        <h1 class="title">Таблица данных</h1>
        <div class="columns is-multiline">
            @foreach (var rental in Model.Rentals)
            {
                @if (rental.Driver == null || rental.Car == null)
                {
                    <div class="column is-full has-text-centered">Bad Data</div>
                    continue;
                }

                <div class="column is-one-quarter">
                    <div class="box">
                        <div class="is-flex is-align-items-center mb-2">
                            <span class="icon is-large mr-2"><i class="fas fa-user fa-2x"></i></span>
                            <a href="/history?page=1&objFilter=@(rental.Driver.Id)" class="title is-6">@rental.Driver.Fio</a>
                        </div>
                        <div class="is-flex is-align-items-center mb-2">
                            <span class="icon is-large mr-2"><i class="fas fa-car fa-2x"></i></span>
                            <a href="/history?page=1&objFilter=@(rental.Car.Id)" class="title is-6">@rental.Car.BrandModel (@rental.Car.PlateNumber)</a>
                        </div>
                        <div class="field is-horizontal mb-1">
                            <div class="field-label is-normal">
                                <label class="label">Баланс:</label>
                            </div>
                            <div class="field-body">
                                <div class="field">
                                    <p class="control">
                                        <input type="number" class="input is-small" value="@rental.Driver.Balance.ToString(CultureInfo.InvariantCulture).Replace(',', '.')" readonly>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="field is-horizontal mb-3">
                            <div class="field-label is-normal">
                                <label class="label">Аренда:</label>
                            </div>
                            <div class="field-body">
                                <div class="field">
                                    <p class="control">
                                        <input type="number" step=".01" class="input is-small" value="@rental.Rent.ToString(CultureInfo.InvariantCulture).Replace(',', '.')" readonly>
                                    </p>
                                </div>
                            </div>
                        </div>


                        <div class="buttons is-fullwidth">
                            <a class="button is-info is-fullwidth" href="/driver/addbalance?driverId=@rental.DriverId">
                                <span class="icon"><i class="fas fa-plus"></i></span>
                                <span>Депозит</span>
                            </a>
                            <a class="button is-info is-fullwidth" href="/home/editschedule?rentId=@rental.Id">
                                <span class="icon"><i class="fas fa-calendar"></i></span>
                                <span>Расписание</span>
                            </a>
                            <button class="button is-warning is-fullwidth edit-button"
                                data-driver="@rental.DriverId"
                                data-car="@rental.CarId"
                                data-rent="@rental.Rent.ToString(CultureInfo.InvariantCulture).Replace(',', '.')"
                                data-id="@rental.Id">
                                <span class="icon"><i class="fas fa-edit"></i></span>
                                <span>Редактировать</span>
                            </button>
                            <button class="button is-danger is-fullwidth delete-button" data-id="@rental.Id">
                                <span class="icon"><i class="fas fa-trash"></i></span>
                                <span>Удалить</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="container is-fluid px-0">
        <h1 class="title">Добавить или редактировать пару</h1>

        <form id="pairForm" class="block box">
            <div class="field">
                <label class="label" for="driverSelect">Выберите водителя:</label>
                <div class="control">
                    <div class="select">
                        <select id="driverSelect" required>
                            @foreach (var driver in Model.Drivers)
                            {
                                <option value="@driver.Id">@driver.Fio</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="field">
                <label class="label" for="carSelect">Выберите машину:</label>
                <div class="control">
                    <div class="select">
                        <select id="carSelect" required>
                            @foreach (var car in Model.Cars)
                            {
                                <option value="@car.Id">@car.BrandModel (@car.PlateNumber)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="field">
                <label class="label" for="rent">Аренда:</label>
                <div class="control">
                    <input class="input" type="number" id="rent" step="0.01" required>
                </div>
            </div>


            <input type="hidden" id="pairId">

            <div class="field is-grouped">
                <div class="control">
                    <button class="button is-primary" type="submit" id="saveButton">Добавить пару</button>
                </div>
                <div class="control">
                    <button class="button is-link is-light" type="button" id="cancelButton">Отмена</button>
                </div>
            </div>

        </form>
    </div>

    <div class="container is-fluid px-0">
        <h1 class="title">Списание аренды</h1>
        <button class="button is-danger block" id="writeOffButton">Списать аренду</button>
        <div id="writeOffBlock" class="block box">

            @if (!Model.IsJobServerDown)
            {
                <form action="/home/changejobstatus" method="post">
                    <p class="is-size-5" style="color: @(Model.IsJobEnable ? "green" : "red")">Автоматическое списание аренды @(Model.IsJobEnable ? "включено" : "выключено")</p>
                    <input name="newStatus" hidden value="@((!Model.IsJobEnable).ToString())">
                    <button class="button is-@(Model.IsJobEnable ? "danger" : "success")" type="submit">@(Model.IsJobEnable ? "Выключить" : "Включить")</button>
                </form>
            }
            else
            {
                <h2 class="title is-2" style="color: red;">Job server is down</h2>
            }
        </div>
    </div>
</section>

@section Scripts
    {
    <script src="js/index.js"></script>

    @Html.Raw("<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.2.1/css/fontawesome.min.css\" integrity=\"sha384-QYIZto+st3yW+o8+5OHfT6S482Zsvz2WfOzpFSXMF9zqeLcFV0/wlZpMtyFcZALm\" crossorigin=\"anonymous\">")

    <script src="https://kit.fontawesome.com/e5e3c0c905.js" crossorigin="anonymous"></script>

    }